# Database (used by docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=ClientDatabase

# Assistant / OpenAI (used in iaff_assistant/realtime_pipeline.py and iaff_assistant/TranslationAgent.py)
# OPENAI_API_TYPE example: "azure" or leave empty for openai
OPENAI_API_TYPE=
OPENAI_API_VERSION=
OPENAI_API_BASE=
OPENAI_API_KEY=your_openai_api_key_here

# Azure Speech (used in iaff_assistant/SpeechRecognitionAgent.py)
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_REGION=your_azure_region_here

# Frontend envs (used in iaff_front/src/*)
REACT_APP_BACK_END_URL=http://localhost:5001/
REACT_APP_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
REACT_APP_BOOKINGCOM_URL=https://your-booking-api.example/
REACT_APP_BOOKINGCOM_KEY=your_booking_api_key_here

# Google Search (move these from iaff_assistant/tools/google_search.py into envs)
GOOGLE_CSE_ID=your_google_cse_id_here
GOOGLE_API_KEY=your_google_api_key_here

# Flask secret key (recommended replacement for hardcoded SECRET_KEY in iaff_back/app.py)
FLASK_SECRET_KEY=your_flask_secret_here

# Notes:
# - Populate .env from .env.example and do NOT commit real secrets to version control.
# - Files that reference these variables: iaff_assistant/realtime_pipeline.py, iaff_assistant/TranslationAgent.py,
#   iaff_assistant/SpeechRecognitionAgent.py, iaff_assistant/tools/google_search.py,
#   iaff_front/src/components/MapConfiguration/MapConfiguration.js, docker-compose.yml
